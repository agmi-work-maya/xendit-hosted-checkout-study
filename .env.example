# Xendit secret API key (Dashboard > Settings > API Keys). Use a test-mode key.
XENDIT_SECRET_KEY=xnd_development_xxx
# Webhook verification token (Dashboard > Settings > Webhooks)
XENDIT_CALLBACK_TOKEN=
XENDIT_API_VERSION=2024-11-11
PORT=3000
# Public URL of this app, used for return URLs
APP_BASE_URL=http://localhost:3000
